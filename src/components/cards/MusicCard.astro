---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { breakpoints } from '../../data/breakpoints';

export interface MusicCardAction {
  label: string;
  href: string;
  /** Icon file name in src/icons (without .svg) */
  icon?: string;
  /** Show the icon in its official brand color (Spotify, YouTube) */
  brandIcon?: boolean;
  variant?: 'primary' | 'secondary' | 'tertiary';
}

interface Props {
  cover: ImageMetadata;
  coverAlt: string;
  text: string;
  /** Shorter copy for phones (below 480px), where the full text crowds the card */
  textShort?: string;
  actions: MusicCardAction[];
  /**
   * responsive: compact on phones (cover + text, buttons below), horizontal from
   *   480px, vertical on tablet, horizontal from desktop (hero design)
   * horizontal / vertical: fixed at every breakpoint
   */
  layout?: 'responsive' | 'horizontal' | 'vertical';
  class?: string;
}

const { cover, coverAlt, text, textShort, actions, layout = 'responsive', class: className } = Astro.props;
---

<article class:list={['music-card', `music-card--${layout}`, className]}>
  <div class="music-card__cover">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[120, 240, 360]}
      sizes={`(min-width: ${breakpoints.tablet}px) 120px, (min-width: ${breakpoints.mobile}px) 112px, 84px`}
      loading="eager"
    />
  </div>

  <div class="music-card__content">
    {textShort ? (
      <p class="music-card__text">
        <span class="music-card__text-short">{textShort}</span>
        <span class="music-card__text-full">{text}</span>
      </p>
    ) : (
      <p class="music-card__text">{text}</p>
    )}

    {actions.length > 0 && (
      <div class="music-card__actions">
        {actions.map((action) => (
          <Button
            href={action.href}
            external
            variant={action.variant ?? 'primary'}
            size={{ base: 'md', tablet: 'sm' }}
            icon={action.icon ? { name: action.icon, brand: action.brandIcon } : undefined}
          >
            {action.label}
          </Button>
        ))}
      </div>
    )}
  </div>
</article>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/base/breakpoints' as *;
  @use '../../styles/base/mixins' as *;

  // Component tokens: cover size per breakpoint (keep the `sizes` attribute above in sync)
  $cover-size-phone-min: 4.5rem; // 72px, smallest phones
  $cover-size-phone: 5.25rem; // 84px
  $cover-size-mobile: 7rem; // 112px
  $cover-size-tablet: 7.5rem; // 120px
  // Desktop: matches the height of text (3 lines) + buttons, so the cover fills the
  // card's full inner height. Re-check if the copy grows.
  $cover-size-desktop: 7.25rem; // 116px
  // Fluid copy on phones (below 480px)
  $text-size-phone: clamp(0.875rem, 4.2vw, 1rem); // 14px → 16px

  .music-card {
    @include glass('dark', $blur-xl);

    display: flex;
    gap: $space-2;
    padding: $space-2;
    border-radius: $radius-xl;
    color: $color-text-on-dark;

    @include desktop {
      border-radius: $radius-2xl;
    }
  }

  .music-card__cover {
    flex-shrink: 0;
    // Always 1:1: never stretch to the content's height
    align-self: flex-start;
    width: $cover-size-phone;
    aspect-ratio: 1;
    border-radius: $radius-md;
    overflow: hidden;
    box-shadow: $shadow-button;

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @include mobile {
      width: $cover-size-mobile;
    }

    @include tablet {
      width: $cover-size-tablet;
    }

    @include desktop {
      width: $cover-size-desktop;
    }
  }

  .music-card__content {
    display: flex;
    flex-direction: column;
    // Text on top, buttons pinned to the bottom (gap = minimum spacing)
    justify-content: space-between;
    gap: $space-1-5;
    min-width: 0;
  }

  .music-card__text {
    font-size: $text-base;
    font-weight: $font-medium;
    line-height: $leading-snug;
    text-wrap: pretty;
  }

  .music-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: $space-1;
  }

  // Short copy on phones, full copy from 480px (only one is ever rendered,
  // so screen readers read one)
  .music-card__text-full {
    display: none;
  }

  @include mobile {
    .music-card__text-short {
      display: none;
    }

    .music-card__text-full {
      display: inline;
    }
  }

  // ---------- Layouts ----------
  // Horizontal: content stretches to the cover height so space-between works
  .music-card--horizontal {
    flex-direction: row;
    align-items: stretch;
  }

  .music-card--vertical {
    flex-direction: column;
  }

  // Phones (below 480px): cover and text side by side, buttons below sharing
  // the full width. The content wrapper steps aside (display: contents) so
  // text and buttons join the card's grid.
  .music-card--responsive {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: $space-2 $space-1-5;

    // Only below 480px: from there the base cover sizes apply
    @media (max-width: ($bp-mobile - 0.02px)) {
      .music-card__cover {
        width: clamp(#{$cover-size-phone-min}, 22vw, #{$cover-size-phone});
      }
    }

    .music-card__content {
      display: contents;
    }

    .music-card__text {
      font-size: $text-size-phone;
    }

    .music-card__actions {
      grid-column: 1 / -1;
      display: grid;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
      gap: $space-1;

      :global(.btn) {
        width: 100%;
      }
    }

    @include mobile {
      display: flex;
      flex-direction: row;
      align-items: stretch;
      gap: $space-2;

      .music-card__content {
        display: flex;
      }

      .music-card__text {
        font-size: $text-base;
      }

      .music-card__actions {
        display: flex;

        :global(.btn) {
          width: auto;
        }
      }
    }

    @include tablet {
      flex-direction: column;
      align-items: flex-start;

      .music-card__text {
        font-size: $text-sm;
      }
    }

    @include desktop {
      flex-direction: row;
      align-items: stretch;
      gap: $space-2-5;
      padding: $space-2-5;

      .music-card__text {
        font-size: $text-base;
      }
    }
  }
</style>
