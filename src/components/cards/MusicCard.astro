---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';

export interface MusicCardAction {
  label: string;
  href: string;
  /** Icon file name in src/icons (without .svg) */
  icon?: string;
  iconColor?: string;
  variant?: 'primary' | 'secondary' | 'tertiary';
}

interface Props {
  cover: ImageMetadata;
  coverAlt: string;
  text: string;
  actions: MusicCardAction[];
  /**
   * responsive: horizontal on mobile, vertical on tablet, horizontal from desktop (hero design)
   * horizontal / vertical: fixed at every breakpoint
   */
  layout?: 'responsive' | 'horizontal' | 'vertical';
  class?: string;
}

const { cover, coverAlt, text, actions, layout = 'responsive', class: className } = Astro.props;
---

<article class:list={['music-card', `music-card--${layout}`, className]}>
  <div class="music-card__cover">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[120, 240, 360]}
      sizes="(min-width: 768px) 120px, 112px"
      loading="eager"
    />
  </div>

  <div class="music-card__content">
    <p class="music-card__text">{text}</p>

    {actions.length > 0 && (
      <div class="music-card__actions">
        {actions.map((action) => (
          <Button
            href={action.href}
            external
            variant={action.variant ?? 'primary'}
            size={{ base: 'sm', mobile: 'md', tablet: 'sm' }}
            icon={action.icon ? { name: action.icon, color: action.iconColor } : undefined}
          >
            {action.label}
          </Button>
        ))}
      </div>
    )}
  </div>
</article>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/base/breakpoints' as *;
  @use '../../styles/base/mixins' as *;

  .music-card {
    @include glass('dark', $blur-xl);

    display: flex;
    gap: $space-2;
    padding: $space-2;
    border-radius: $radius-xl;
    color: $color-text-on-dark;

    @include desktop {
      border-radius: $radius-2xl;
    }
  }

  .music-card__cover {
    flex-shrink: 0;
    width: 5.25rem; // 84px on small phones
    aspect-ratio: 1;
    border-radius: $radius-md;
    overflow: hidden;
    box-shadow: $shadow-button;

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @include mobile {
      width: 7rem; // 112px
    }

    @include tablet {
      width: 7.5rem; // 120px
    }

    @include desktop {
      width: 6.5rem; // 104px
    }
  }

  .music-card__content {
    display: flex;
    flex-direction: column;
    // Text on top, buttons pinned to the bottom (gap = minimum spacing)
    justify-content: space-between;
    gap: $space-1-5;
    min-width: 0;
  }

  .music-card__text {
    font-size: $text-base;
    font-weight: $font-medium;
    line-height: $leading-snug;
    text-wrap: pretty;
  }

  .music-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: $space-1;
  }

  // ---------- Layouts ----------
  // Horizontal: content stretches to the cover height so space-between works
  .music-card--horizontal {
    flex-direction: row;
    align-items: stretch;
  }

  .music-card--vertical {
    flex-direction: column;
  }

  .music-card--responsive {
    flex-direction: row;
    align-items: stretch;

    @include tablet {
      flex-direction: column;
      align-items: flex-start;

      .music-card__text {
        font-size: $text-sm;
      }
    }

    @include desktop {
      flex-direction: row;
      align-items: stretch;
      gap: 1.25rem;
      padding: 1.25rem;

      .music-card__text {
        font-size: $text-base;
      }
    }
  }
</style>
