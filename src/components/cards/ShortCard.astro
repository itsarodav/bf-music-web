---
// Vertical video card (9:16). The whole card is one link to the platform;
// its accessible name is the title plus where it opens.
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import NewTabHint from '../ui/NewTabHint.astro';
import { breakpoints } from '../../data/breakpoints';

interface Props {
  title: string;
  url: string;
  /** ISO date */
  publishedAt: string;
  thumbnail: { src: string; width: number; height: number };
  /** Where the video opens: its logo leads the date line */
  platform?: { name: string; icon: string };
  /** Load the image right away (first card on mobile is in view) */
  eager?: boolean;
  class?: string;
}

const { title, url, publishedAt, thumbnail, platform = { name: 'YouTube', icon: 'youtube' }, eager = false, class: className } = Astro.props;

// Absolute date: a relative one ("hace 2 días") would go stale between builds
const date = new Date(publishedAt);
const dateLabel = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' })
  .format(date)
  .replace('.', '');
---

<a href={url} class:list={['short-card', className]} target="_blank" rel="noopener noreferrer">
  <div class="short-card__media">
    <Image
      src={thumbnail.src}
      width={thumbnail.width}
      height={thumbnail.height}
      alt=""
      widths={[240, 320, 480, 640]}
      sizes={`(min-width: ${breakpoints.tablet}px) 300px, 240px`}
      loading={eager ? 'eager' : 'lazy'}
    />
    <span class="short-card__play" aria-hidden="true">
      <Icon name="play" size={16} />
    </span>
  </div>

  <div class="short-card__body">
    <p class="short-card__title">{title}</p>
    <p class="short-card__meta">
      <Icon name={platform.icon} size={16} class="short-card__platform" />
      <span class="visually-hidden">{platform.name},</span>
      <time datetime={date.toISOString()}>{dateLabel}</time>
      <NewTabHint />
    </p>
  </div>
</a>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/base/breakpoints' as *;
  @use '../../styles/base/mixins' as *;

  // Component tokens
  $play-size: 2.5rem; // 40px glass badge
  $play-optical-offset: 2px; // nudges the triangle right so it looks centered
  $media-hover-zoom: 1.05;
  $play-hover-scale: 1.08;
  $play-press-scale: 0.94;

  .short-card {
    @include focus-ring(4px, $color-focus-ring-on-light);

    // Containing block for the visually-hidden labels (position: absolute):
    // without it they'd escape the carousel's clipping and widen the page
    position: relative;
    display: flex;
    flex-direction: column;
    gap: $space-1-5;
    color: $color-text-on-light;
    text-decoration: none;
    border-radius: $radius-xl;
    -webkit-tap-highlight-color: transparent;
  }

  .short-card__media {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: $radius-xl;
    overflow: hidden;
    background-color: $color-placeholder-on-light; // while the image loads
    // Keeps the rounded clip during the zoom in Safari
    isolation: isolate;

    // Soft shade at the bottom so the play badge always reads
    &::after {
      content: '';
      position: absolute;
      inset: 55% 0 0;
      background: linear-gradient(180deg, transparent, $overlay-media-bottom);
      pointer-events: none;
    }

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform $duration-slower $ease-out;
    }

    @include desktop {
      border-radius: $radius-2xl;
    }
  }

  .short-card__play {
    @include glass('dark', $blur-md);
    @include transition(transform, background-color);

    position: absolute;
    z-index: $z-base;
    right: $space-1-5;
    bottom: $space-1-5;
    display: grid;
    place-items: center;
    width: $play-size;
    height: $play-size;
    border-radius: $radius-pill;
    color: $color-text-on-dark;

    :global(svg) {
      margin-left: $play-optical-offset;
    }
  }

  .short-card__body {
    display: flex;
    flex-direction: column;
    gap: $space-0-5;
    padding-inline: $space-0-5;
  }

  .short-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: $text-base;
    font-weight: $font-medium;
    line-height: $leading-snug;
    text-wrap: pretty;
  }

  .short-card__meta {
    display: flex;
    align-items: center;
    gap: $space-0-75;
    font-size: $text-sm;
    color: $color-text-on-light-muted;
  }

  // Logo in the muted text color (the YouTube triangle stays white)
  .short-card__meta :global(.short-card__platform) {
    flex-shrink: 0;
    color: $color-text-on-light-subtle;
  }

  // Hover: slow zoom on the photo, the badge lifts a little
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .short-card:hover {
      .short-card__media :global(img) {
        transform: scale($media-hover-zoom);
      }

      .short-card__play {
        transform: scale($play-hover-scale);
      }
    }
  }

  .short-card:active .short-card__play {
    transform: scale($play-press-scale);
  }
</style>
