---
// Site footer: sitemap, legal links and brand logos, followed by the credits bar.
import Icon from '../ui/Icon.astro';
import Credits from './Credits.astro';
import { getSitemapLinks, getLegalLinks } from '../../data/navigation';
import { site, credits } from '../../data/site';
import { getI18n, localizePath } from '../../i18n';

const { locale, routeId, t } = getI18n(Astro.url);
---

<footer class="footer" data-nav-theme="light">
  <div class="footer__main">
    <nav class="footer__nav" aria-label={t('nav.sitemap')}>
      <ul class="footer__list">
        {getSitemapLinks(locale).map((link) => (
          <li>
            <a
              href={link.href}
              class="footer__link"
              aria-current={link.routeId === routeId ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav class="footer__nav" aria-label={t('nav.legal')}>
      <ul class="footer__list">
        {getLegalLinks(locale).map((link) => (
          <li>
            <a
              href={link.href}
              class="footer__link"
              aria-current={link.routeId === routeId ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="footer__brands">
      <a href={localizePath('home', locale)} class="footer__brand" aria-label={t('nav.homeLabel', { name: site.name })}>
        <Icon name="logo-bf" size={88} class="footer__brand-icon" />
      </a>
      <a
        href={credits.agency.href}
        class="footer__brand"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${credits.agency.label} ${t('a11y.newTab')}`}
      >
        <Icon name="lemonims" size={88} class="footer__brand-icon" />
      </a>
    </div>
  </div>

  <Credits />
</footer>
