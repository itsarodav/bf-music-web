---
// Collage of three square (1:1) pieces, slightly rotated and overlapping.
// Phones: the first two side by side on top, the third below, centered.
// Tablet+: one row, the third piece in the middle and on top.
// Pass items in reading order; the third is the featured one (e.g. the video).
// An image without `src` renders a colored placeholder until the photo arrives.
// The video autoplays (muted, looped) only while on screen, and never with
// reduced motion (the poster shows instead). Entrance animation: GSAP, once.
// Any piece can carry a `tooltip`: an always-visible callout above or below
// it (`tooltipPlacement`), kept
// level even though the piece is rotated. `stickers` lays doodles (flowers,
// sparkles) over the pieces; each one names a spot from $stickers below.
import { Image } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import NewTabHint from '../ui/NewTabHint.astro';
import Tooltip, { type TooltipPlacement } from '../ui/Tooltip.astro';
import Flower, { type FlowerTone } from '../ui/Flower.astro';
import Sparkle from '../ui/Sparkle.astro';
import { breakpoints } from '../../data/breakpoints';

interface CollageItemBase {
  /** Callout on the piece (e.g. "Grabado en el estudio") */
  tooltip?: string;
  /** Above (default) or below the piece */
  tooltipPlacement?: TooltipPlacement;
}

export interface CollageImage extends CollageItemBase {
  type: 'image';
  src?: ImageMetadata;
  alt?: string;
}

export interface CollageVideo extends CollageItemBase {
  type: 'video';
  /** In order of preference (webm first) */
  sources: { src: string; type: string }[];
  poster: string;
  /** Accessible name: what the video shows (or where the link goes) */
  label: string;
  /** Optional link, opens in a new tab */
  href?: string;
}

export type CollageItem = CollageImage | CollageVideo;

/** Spots defined in $stickers (position, size and tilt per breakpoint) */
export type StickerSpot = 'seam' | 'corner' | 'edge' | 'shine' | 'shine-sm';

export type CollageSticker =
  | { kind: 'flower'; tone: FlowerTone; spot: StickerSpot }
  | { kind: 'sparkle'; spot: StickerSpot };

interface Props {
  items: [CollageItem, CollageItem, CollageItem];
  /** Flip the composition left-right (positions and rotations), so two
   *  collages on one page don't repeat */
  mirror?: boolean;
  /** Doodles over the pieces, drawn above them */
  stickers?: CollageSticker[];
  class?: string;
}

const { items, mirror = false, stickers = [], class: className } = Astro.props;

// Each piece is ~48% of the column on phones and ~36% from tablet
const imageSizes = `(min-width: ${breakpoints.tablet}px) 260px, 48vw`;
---

<div class:list={['media-collage', { 'media-collage--mirror': mirror }, className]} data-media-collage>
  {items.map((item) => (
    <div class="media-collage__item" data-media-collage-item>
      {item.tooltip && <Tooltip placement={item.tooltipPlacement} class="media-collage__tooltip">{item.tooltip}</Tooltip>}
      <div class="media-collage__frame">
        {item.type === 'image' ? (
          item.src ? (
            <Image src={item.src} alt={item.alt ?? ''} widths={[260, 400, 520, 780]} sizes={imageSizes} loading="lazy" />
          ) : (
            <div class="media-collage__placeholder" aria-hidden="true"></div>
          )
        ) : (
          (() => {
            const video = (
              <video muted loop playsinline preload="none" poster={item.poster} aria-hidden="true" data-media-collage-video>
                {item.sources.map((source) => <source src={source.src} type={source.type} />)}
              </video>
            );
  
            return item.href ? (
              <a href={item.href} class="media-collage__link" target="_blank" rel="noopener noreferrer">
                {video}
                <span class="media-collage__play" aria-hidden="true">
                  <Icon name="play" size={16} />
                </span>
                <span class="visually-hidden">{item.label}</span>
                <NewTabHint />
              </a>
            ) : (
              <>
                {video}
                <span class="visually-hidden">{item.label}</span>
              </>
            );
          })()
        )}
      </div>
    </div>
  ))}
  {stickers.map((sticker) => (
    <div class={`media-collage__sticker media-collage__sticker--${sticker.spot}`} data-media-collage-sticker>
      {sticker.kind === 'flower' ? <Flower tone={sticker.tone} /> : <Sparkle />}
    </div>
  ))}
</div>

<style lang="scss">
  @use 'sass:list';
  @use 'sass:map';
  @use '../../styles/tokens' as *;
  @use '../../styles/base/breakpoints' as *;
  @use '../../styles/base/mixins' as *;

  // Component tokens. Each piece is placed with % of the collage: x and size
  // are % of its width, y is % of its height (the collage keeps an aspect
  // ratio, so the pieces stay square and in place at any width).
  $collage-ratio-mobile: list.slash(10, 9); // two on top, one below (tight stack)
  $collage-ratio-tablet: 2; // one row

  $item-size-mobile: 48%;
  $item-size-tablet: 36%;

  // Slot: (x, y, rotation) per breakpoint
  $slots-mobile: (
    1: (4%, 2%, -4deg),
    2: (48%, 6%, 3.5deg),
    3: (26%, 43%, -2deg),
  );
  $slots-tablet: (
    1: (0%, 20%, -5deg),
    2: (64%, 16%, 4.5deg),
    3: (32%, 6%, 3deg),
  );

  // Mirrored, tablet+: the middle piece drops lower than in the normal
  // layout, so the change between two collages reads clearly
  $mirror-featured-drop-tablet: 16%;

  $play-size: 2.5rem; // 40px glass badge, same as the Short cards
  $play-optical-offset: 2px; // nudges the triangle right so it looks centered
  $item-hover-scale: 1.03;
  $tooltip-wiggle-tilt: 6deg; // widest swing, each one after it smaller
  $tooltip-wiggle-duration: 700ms;

  // Stickers: center (x, y) per breakpoint, same % system as the slots,
  // measured on the collage as it renders (already mirrored, never flipped);
  // size is % of the collage width; tilt so they look hand-placed.
  // seam:   over the first photo and the featured piece, where they meet
  // corner: half off the top edge of the second photo, near its outer corner
  // edge:   half off the outer edge of the first photo (mirrored collage)
  // shine, shine-sm: sparkle pair on the top outer corner of the second
  //         photo (mirrored collage)
  $stickers: (
    seam: (
      mobile: (27%, 50%),
      tablet: (34%, 72%),
      size-mobile: 9.5%,
      size-tablet: 6.5%,
      rotation: -12deg,
    ),
    corner: (
      mobile: (89%, 7.5%),
      tablet: (93%, 18%),
      size-mobile: 8%,
      size-tablet: 5%,
      rotation: 18deg,
    ),
    edge: (
      mobile: (95%, 42%),
      tablet: (98.5%, 74%),
      size-mobile: 11%,
      size-tablet: 7.5%,
      rotation: 14deg,
    ),
    shine: (
      mobile: (10%, 5.5%),
      tablet: (7%, 20.5%),
      size-mobile: 9%,
      size-tablet: 5.5%,
      rotation: 0deg,
    ),
    shine-sm: (
      mobile: (14.5%, 0%),
      tablet: (10%, 15.5%),
      size-mobile: 5%,
      size-tablet: 3%,
      rotation: 0deg,
    ),
  );

  // Places each piece in its slot. Mirrored: the x is measured from the other
  // side and the rotation flips, so the piece lands in its reflection.
  @mixin place-slots($slots, $size, $mirror: false) {
    @each $slot, $pos in $slots {
      $x: list.nth($pos, 1);
      $rotation: list.nth($pos, 3);

      @if $mirror {
        $x: 100% - $size - $x;
        $rotation: -1 * $rotation;
      }

      &:nth-child(#{$slot}) {
        --item-rotation: #{$rotation};

        left: $x;
        top: list.nth($pos, 2);
      }
    }
  }

  // Places a sticker's center
  @mixin place-sticker($pos) {
    left: list.nth($pos, 1);
    top: list.nth($pos, 2);
  }

  .media-collage {
    position: relative;
    width: 100%;
    aspect-ratio: $collage-ratio-mobile;

    @include tablet {
      aspect-ratio: $collage-ratio-tablet;
    }
  }

  .media-collage__item {
    @include transition(scale);

    position: absolute;
    width: $item-size-mobile;
    aspect-ratio: 1;
    rotate: var(--item-rotation);
    border-radius: $radius-xl;
    background-color: $color-placeholder-on-light; // while the media loads
    box-shadow: $shadow-collage;

    @include place-slots($slots-mobile, $item-size-mobile);

    // The featured piece sits on top of the other two, with deeper side shadows
    &:nth-child(3) {
      z-index: $z-base;
      box-shadow: $shadow-collage-featured;
    }

    @include tablet {
      width: $item-size-tablet;

      @include place-slots($slots-tablet, $item-size-tablet);
    }

    @include desktop {
      border-radius: $radius-2xl;
    }
  }

  // Clips the media to the rounded corners. Lives inside the piece (not on it)
  // so a tooltip can stick out above the edge.
  .media-collage__frame {
    height: 100%;
    border-radius: inherit;
    overflow: hidden;
    // Keeps the rounded clip on the video in Safari
    isolation: isolate;

    :global(img),
    video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  .media-collage--mirror .media-collage__item {
    @include place-slots($slots-mobile, $item-size-mobile, true);

    @include tablet {
      @include place-slots($slots-tablet, $item-size-tablet, true);

      &:nth-child(3) {
        top: list.nth(map.get($slots-tablet, 3), 2) + $mirror-featured-drop-tablet;
      }
    }
  }

  // The tooltip undoes the piece's rotation so it always reads level
  .media-collage__item :global(.media-collage__tooltip) {
    rotate: calc(-1 * var(--item-rotation));
  }

  // Takes the pointer so the doodle can react on hover (Flower, Sparkle)
  .media-collage__sticker {
    position: absolute;
    z-index: $z-raised;
    translate: -50% -50%;
  }

  @each $spot, $sticker in $stickers {
    .media-collage__sticker--#{$spot} {
      width: map.get($sticker, size-mobile);
      rotate: map.get($sticker, rotation);

      @include place-sticker(map.get($sticker, mobile));

      @include tablet {
        width: map.get($sticker, size-tablet);

        @include place-sticker(map.get($sticker, tablet));
      }
    }
  }

  .media-collage__placeholder {
    width: 100%;
    height: 100%;
    background-color: $color-placeholder-media;
  }

  .media-collage__link {
    @include focus-ring(-4px, $color-focus-ring);

    position: relative;
    display: block;
    height: 100%;
    border-radius: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .media-collage__play {
    @include glass('dark', $blur-md);

    position: absolute;
    right: $space-1-5;
    bottom: $space-1-5;
    display: grid;
    place-items: center;
    width: $play-size;
    height: $play-size;
    border-radius: $radius-pill;
    color: $color-text-on-dark;

    :global(svg) {
      margin-left: $play-optical-offset;
    }
  }

  // Hover: the piece leans out a little (the linked video invites the click)
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .media-collage__item:hover {
      scale: $item-hover-scale;
    }

    // Its tooltip wiggles left and right once, like a message arriving.
    // `transform`, so it adds to the tooltip's own rotate and translate.
    .media-collage__item:hover :global(.media-collage__tooltip) {
      animation: media-collage-tooltip-wiggle $tooltip-wiggle-duration $ease-in-out;
    }
  }

  @keyframes media-collage-tooltip-wiggle {
    0%,
    100% {
      transform: none;
    }

    15% {
      transform: rotate(-1 * $tooltip-wiggle-tilt);
    }

    35% {
      transform: rotate($tooltip-wiggle-tilt);
    }

    55% {
      transform: rotate(-0.5 * $tooltip-wiggle-tilt);
    }

    75% {
      transform: rotate(0.25 * $tooltip-wiggle-tilt);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { autoplayInView } from '../../scripts/autoplay-in-view';

  gsap.registerPlugin(ScrollTrigger);

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-media-collage]').forEach((collage) => {
    // Video: plays only while on screen, poster otherwise
    autoplayInView(collage.querySelectorAll<HTMLVideoElement>('[data-media-collage-video]'));

    // Entrance: the pieces rise and settle one after another, short and quick
    // so it never holds the scroll back. Rotation lives in CSS (`rotate`),
    // so GSAP's transform only adds the lift on top.
    if (!reducedMotion) {
      gsap.from(collage.querySelectorAll('[data-media-collage-item], [data-media-collage-sticker]'), {
        autoAlpha: 0,
        y: 32,
        scale: 0.94,
        duration: 0.6,
        ease: 'power3.out',
        stagger: 0.08,
        clearProps: 'transform,opacity,visibility',
        scrollTrigger: { trigger: collage, start: 'top 85%', once: true },
      });
    }
  });
</script>
