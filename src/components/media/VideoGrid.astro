---
// Grid of looping video cards (Film Scoring), every card 16:9.
// Phones: one column.
// From tablet: a pyramid of six on a 6-column grid, repeating if more come:
//   row 1: one card across the full width
//   row 2: two cards, half each
//   row 3: three cards, a third each (compact: logo-only YouTube button)
// Only the first card of each group autoplays on devices with a mouse; the
// others play on hover (touch devices play every loop in view).
import VideoCard, { type LoopVideo } from '../cards/VideoCard.astro';

export interface VideoGridItem {
  title: string;
  href: string;
  video?: LoopVideo;
}

interface Props {
  items: VideoGridItem[];
  /** Accessible name of the list */
  label: string;
  class?: string;
}

const { items, label, class: className } = Astro.props;

// Positions 4, 5 and 6 of each group of six make the third row
const isCompact = (index: number) => index % 6 >= 3;
---

<ul class:list={['video-grid', className]} aria-label={label}>
  {items.map((item, index) => (
    <li class="video-grid__item">
      <VideoCard {...item} compact={isCompact(index)} hoverPlay={index % 6 !== 0} />
    </li>
  ))}
</ul>

<style lang="scss">
  @use '../../styles/tokens' as *;
  @use '../../styles/base/breakpoints' as *;

  // Component tokens: 6 columns split 6 / 3 + 3 / 2 + 2 + 2
  $grid-columns: 6;
  $span-full: 6;
  $span-half: 3;
  $span-third: 2;

  .video-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: $space-5;
    list-style: none;

    @include tablet {
      grid-template-columns: repeat($grid-columns, minmax(0, 1fr));
      gap: $space-5 $space-2;
    }
  }

  @include tablet {
    .video-grid__item {
      // Row 1: full width
      &:nth-child(6n + 1) {
        grid-column: span $span-full;
      }

      // Row 2: halves
      &:nth-child(6n + 2),
      &:nth-child(6n + 3) {
        grid-column: span $span-half;
      }

      // Row 3: thirds
      &:nth-child(6n + 4),
      &:nth-child(6n + 5),
      &:nth-child(6n + 6) {
        grid-column: span $span-third;
      }
    }
  }
</style>
