---
// Language switcher. Every option is a real link to the same page in that
// language, so it works without JS and search engines follow it. Two looks:
// - dropdown (navbar, tablet+): "ES ▾" button that opens a small glass panel
//   with each language named in itself and a check on the current one.
// - tabs (mobile menu): segmented control ES | VA | EN.
// Picking a language saves it in the nf_lang cookie: Netlify's language
// redirect on "/" (public/_redirects) honours it, so the browser language
// never overrides a choice. Styles: styles/partials/_lang-switcher.scss.
import Icon from '../ui/Icon.astro';
import { getAlternates, getI18n } from '../../i18n';

interface Props {
  variant: 'dropdown' | 'tabs';
  class?: string;
}

const { variant, class: className } = Astro.props;
const { locale, routeId, t, meta } = getI18n(Astro.url);
const alternates = getAlternates(routeId).map((alternate) => ({
  ...alternate,
  current: alternate.locale === locale ? 'true' : undefined,
}));
---

{variant === 'dropdown' ? (
  <nav class:list={['lang-switcher', className]} aria-label={t('lang.label')} data-lang-switcher>
    <button
      type="button"
      class="lang-switcher__toggle"
      aria-label={t('lang.current', { language: meta.name })}
      aria-expanded="false"
      aria-controls="lang-switcher-menu"
      data-lang-toggle
    >
      {meta.short}
      <Icon name="chevron-down" size={16} class="lang-switcher__chevron" />
    </button>

    <ul id="lang-switcher-menu" class="lang-switcher__menu" data-lang-menu>
      {alternates.map((alternate) => (
        <li>
          <a
            href={alternate.href}
            hreflang={alternate.htmlLang}
            lang={alternate.htmlLang}
            class="lang-switcher__option"
            aria-current={alternate.current}
            data-lang-option={alternate.netlifyLang}
          >
            {alternate.name}
            {alternate.current && <Icon name="check" size={16} class="lang-switcher__check" />}
          </a>
        </li>
      ))}
    </ul>
  </nav>
) : (
  <nav class:list={['lang-tabs', className]} aria-label={t('lang.label')}>
    <ul class="lang-tabs__list">
      {alternates.map((alternate) => (
        <li>
          <a
            href={alternate.href}
            hreflang={alternate.htmlLang}
            lang={alternate.htmlLang}
            class="lang-tabs__tab"
            aria-current={alternate.current}
            data-lang-option={alternate.netlifyLang}
          >
            <span aria-hidden="true">{alternate.short}</span>
            <span class="visually-hidden">{alternate.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<script>
  const COOKIE_MAX_AGE = 60 * 60 * 24 * 365; // 1 year

  // Remember the choice for Netlify's language redirect on "/"
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-option]').forEach((option) => {
    option.addEventListener('click', () => {
      document.cookie = `nf_lang=${option.dataset.langOption}; path=/; max-age=${COOKIE_MAX_AGE}; SameSite=Lax`;
    });
  });

  // Dropdown: opens on click, closes on Escape, an outside click or when focus
  // leaves it. Arrow keys move through the options.
  document.querySelectorAll<HTMLElement>('[data-lang-switcher]').forEach((switcher) => {
    const toggle = switcher.querySelector<HTMLButtonElement>('[data-lang-toggle]');
    const options = [...switcher.querySelectorAll<HTMLAnchorElement>('[data-lang-option]')];
    if (!toggle || !options.length) return;

    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const current = () => options.find((option) => option.hasAttribute('aria-current')) ?? options[0];

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      switcher.classList.toggle('is-open', open);
    };

    const focusOption = (index: number) => options[(index + options.length) % options.length].focus();

    toggle.addEventListener('click', (event) => {
      setOpen(!isOpen());
      // Opened from the keyboard (no pointer, detail 0): straight into the list
      if (isOpen() && event.detail === 0) current().focus();
    });

    toggle.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      setOpen(true);
      current().focus();
    });

    switcher.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      const index = options.indexOf(document.activeElement as HTMLAnchorElement);

      if (event.key === 'Escape') {
        setOpen(false);
        toggle.focus();
      } else if (index >= 0 && (event.key === 'ArrowDown' || event.key === 'ArrowUp')) {
        event.preventDefault();
        focusOption(index + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (index >= 0 && (event.key === 'Home' || event.key === 'End')) {
        event.preventDefault();
        focusOption(event.key === 'Home' ? 0 : -1);
      }
    });

    switcher.addEventListener('focusout', (event) => {
      if (!switcher.contains(event.relatedTarget as Node | null)) setOpen(false);
    });

    document.addEventListener('pointerdown', (event) => {
      if (isOpen() && !switcher.contains(event.target as Node)) setOpen(false);
    });
  });
</script>
