---
import Icon from '../ui/Icon.astro';
import MobileMenu from './MobileMenu.astro';
import LangSwitcher from './LangSwitcher.astro';
import { getNavLinks } from '../../data/navigation';
import { site } from '../../data/site';
import { getI18n, localizePath } from '../../i18n';
import logoUrl from '../../icons/logo-bf.svg?url';

const { locale, routeId, t } = getI18n(Astro.url);
const navLinks = getNavLinks(locale);
---

<header class="navbar" data-navbar>
  <div class="navbar__bar">
    <a href={localizePath('home', locale)} class="navbar__logo" aria-label={t('nav.homeLabel', { name: site.name })} style={`--logo-mask: url(${JSON.stringify(logoUrl)})`}>
      <Icon name="logo-bf" size={88} class="navbar__logo-icon" />
      <!-- Hover: the album cover's colors, cut to the logo's shape -->
      <span class="navbar__logo-gradient" aria-hidden="true"></span>
    </a>

    <!-- Tablet+: links, then the language dropdown after a hairline -->
    <div class="navbar__actions">
      <nav class="navbar__nav" aria-label={t('nav.main')}>
        <ul class="navbar__list">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="navbar__link"
                aria-current={link.routeId === routeId ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <LangSwitcher variant="dropdown" />
    </div>

    <button
      type="button"
      class="navbar__toggle"
      aria-label={t('nav.openMenu')}
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
      data-label-open={t('nav.openMenu')}
      data-label-close={t('nav.closeMenu')}
    >
      <span class="navbar__toggle-line"></span>
      <span class="navbar__toggle-line"></span>
      <span class="navbar__toggle-line"></span>
    </button>
  </div>

  <MobileMenu links={navLinks} currentRouteId={routeId} />
</header>

<script>
  const navbar = document.querySelector<HTMLElement>('[data-navbar]');

  if (navbar) {
    // The line where the bar meets the content (its bottom edge)
    const barHeight = () => navbar.querySelector<HTMLElement>('.navbar__bar')?.offsetHeight ?? 64;

    // Checked live against the real layout (not positions cached on load), so
    // it's right after a reload mid-page, a resize or a section changing
    // height: navbar--light while any light section sits under the bar's
    // bottom edge
    const lightSections = [...document.querySelectorAll<HTMLElement>('[data-nav-theme="light"]')];
    let frame = 0;

    const updateTheme = () => {
      frame = 0;
      const line = barHeight();
      const light = lightSections.some((section) => {
        const { top, bottom } = section.getBoundingClientRect();
        return top <= line && bottom > line;
      });
      navbar.classList.toggle('navbar--light', light);
    };

    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateTheme);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    updateTheme();
  }
</script>
