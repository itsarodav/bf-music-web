---
import Icon from '../ui/Icon.astro';
import MobileMenu from './MobileMenu.astro';
import { navLinks, getCurrentPath } from '../../data/navigation';
import { site } from '../../data/site';

const currentPath = getCurrentPath(Astro.url);
const isCurrent = (href: string) => href === currentPath;
---

<header class="navbar" data-navbar>
  <div class="navbar__bar" data-reveal="navbar">
    <a href="/" class="navbar__logo" aria-label={`${site.name}, inicio`}>
      <Icon name="logo-bf" size={88} class="navbar__logo-icon" />
    </a>

    <nav class="navbar__nav" aria-label="Principal">
      <ul class="navbar__list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="navbar__link"
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="navbar__toggle"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="navbar__toggle-line"></span>
      <span class="navbar__toggle-line"></span>
      <span class="navbar__toggle-line"></span>
    </button>
  </div>

  <MobileMenu links={navLinks} currentPath={currentPath} />
</header>

<script>
  const navbar = document.querySelector<HTMLElement>('[data-navbar]');

  if (navbar) {
    // The line where the bar meets the content (its bottom edge)
    const barHeight = () => navbar.querySelector<HTMLElement>('.navbar__bar')?.offsetHeight ?? 64;

    // Both states are checked live against the real layout (not positions
    // cached on load), so they're right after a reload mid-page, a resize or a
    // section changing height:
    // - is-scrolled: compact bar as soon as the page leaves the top
    // - navbar--light: any light section sits under the bar's bottom edge
    const lightSections = [...document.querySelectorAll<HTMLElement>('[data-nav-theme="light"]')];
    let frame = 0;

    const updateTheme = () => {
      frame = 0;
      const line = barHeight();
      const light = lightSections.some((section) => {
        const { top, bottom } = section.getBoundingClientRect();
        return top <= line && bottom > line;
      });
      navbar.classList.toggle('is-scrolled', window.scrollY > 8);
      navbar.classList.toggle('navbar--light', light);
    };

    const requestUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateTheme);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    updateTheme();
  }
</script>
