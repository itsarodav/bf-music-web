---
// Shared contact section, rendered by Layout on every page.
// The navbar "Contacto" link targets #contacto.
import { contact, socialLinks } from '../../data/contact';
---

<section id="contacto" class="contact" data-nav-theme="light" aria-labelledby="contact-title">
  <h2 id="contact-title" class="contact__title">Contacto</h2>

  <div class="contact__group">
    <h3 class="contact__subtitle">Booking &amp; Management</h3>
    <a href={`mailto:${contact.bookingEmail}`} class="contact__link">{contact.bookingEmail}</a>
  </div>

  <div class="contact__group">
    <h3 class="contact__subtitle">Redes sociales</h3>
    <ul class="contact__social">
      {socialLinks.map((link) => (
        <li>
          <a href={link.href} class="contact__link" target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
