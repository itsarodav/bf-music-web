---
import { getImage } from 'astro:assets';
import MusicCard, { type MusicCardAction } from '../cards/MusicCard.astro';
import { media } from '../../data/breakpoints';

interface Props {
  /** Shown as one word per line on tablet */
  titleWords: string[];
  /** Landscape photo, used on landscape screens */
  background: ImageMetadata;
  /** Portrait crop centered on the artist, used on portrait screens (phones, tablets) */
  backgroundPortrait: ImageMetadata;
  backgroundAlt: string;
  card: {
    cover: ImageMetadata;
    coverAlt: string;
    text: string;
    textShort?: string;
    actions: MusicCardAction[];
  };
}

const { titleWords, background, backgroundPortrait, backgroundAlt, card } = Astro.props;

// Art direction: portrait screens get the portrait crop, so no bytes are spent on
// the sides of the photo that a phone never shows. The image is rendered with a
// 1.1 zoom (1.25 on phones, see _hero.scss), which is why sizes are larger than the cover area.
const PORTRAIT_MEDIA = '(max-aspect-ratio: 1/1)';
const portrait = {
  // Capped at 1440: enough for 3x phones without the weight of the full 1800px crop
  widths: [640, 960, 1280, 1440],
  sizes: `${media.belowTablet} 95vh, (max-aspect-ratio: 3/4) 83vh, 110vw`,
  // 45: no visible loss on the leaves or the face (checked side by side with 55),
  // about a third lighter, and the photo sits under the vignette anyway
  quality: 45,
};
const landscape = {
  widths: [960, 1280, 1600, 1920, 2240, 2560],
  sizes: '(max-aspect-ratio: 4/3) 147vh, 110vw',
  quality: 45,
};
// JPG only reaches browsers without AVIF/WebP: it keeps a higher quality, JPG degrades sooner
const FALLBACK_QUALITY = 55;

const [portraitAvif, portraitWebp, landscapeAvif, landscapeWebp, fallback] = await Promise.all([
  getImage({ src: backgroundPortrait, widths: portrait.widths, format: 'avif', quality: portrait.quality }),
  getImage({ src: backgroundPortrait, widths: portrait.widths, format: 'webp', quality: portrait.quality }),
  getImage({ src: background, widths: landscape.widths, format: 'avif', quality: landscape.quality }),
  getImage({ src: background, widths: landscape.widths, format: 'webp', quality: landscape.quality }),
  getImage({ src: background, width: 1920, format: 'jpg', quality: FALLBACK_QUALITY }),
]);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__media">
    <picture>
      <source media={PORTRAIT_MEDIA} type="image/avif" srcset={portraitAvif.srcSet.attribute} sizes={portrait.sizes} />
      <source media={PORTRAIT_MEDIA} type="image/webp" srcset={portraitWebp.srcSet.attribute} sizes={portrait.sizes} />
      <source type="image/avif" srcset={landscapeAvif.srcSet.attribute} sizes={landscape.sizes} />
      <source type="image/webp" srcset={landscapeWebp.srcSet.attribute} sizes={landscape.sizes} />
      <img
        src={fallback.src}
        alt={backgroundAlt}
        width={background.width}
        height={background.height}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <!-- Dims the photo as the next section covers it (driven by Statement) -->
  <div class="hero__shade" data-hero-shade aria-hidden="true"></div>

  <div class="hero__content" data-hero-content>
    <h1 id="hero-title" class="hero__title">
      {titleWords.map((word, index) => (
        <>
          <span class="hero__title-word" style={`--word-index: ${index}`}>{word}</span>
          {index < titleWords.length - 1 && ' '}
        </>
      ))}
    </h1>

    <div class="hero__card">
      <MusicCard {...card} />
    </div>
  </div>
</section>

