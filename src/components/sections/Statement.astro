---
// Full-screen statement (home: the central sentence of her bio).
// Scroll-driven: the white panel rises over the hero, which stays pinned and
// recedes behind it; then the panel sticks while the words fill in one by one,
// rests with the full sentence, and stays pinned while the next section rises
// over it. Distances live in _statement.scss (--statement-read/-hold).
// Words are split here, at build time.
type Part = string | { em: string };

interface Props {
  id?: string;
  /** Accessible name of the section */
  label: string;
  /** Plain strings and { em } fragments (bold italic), joined as written */
  parts: Part[];
}

const { id = 'intro', label, parts } = Astro.props;

// Each fragment becomes words and the whitespace between them, so the
// browser still breaks lines naturally ("compositora" + "." stay together).
const tokens = parts.flatMap((part) => {
  const em = typeof part !== 'string';
  const text = em ? part.em : part;
  return text.split(/(\s+)/).filter(Boolean).map((value) => ({ value, em, space: /^\s+$/.test(value) }));
});
---

<section id={id} class="statement" aria-label={label} data-statement data-nav-theme="light">
  <div class="statement__panel" data-statement-panel>
    <p class="statement__text" data-statement-text>
      {tokens.map((token) =>
        token.space ? (
          token.value
        ) : token.em ? (
          <em class="statement__word" data-statement-word>{token.value}</em>
        ) : (
          <span class="statement__word" data-statement-word>{token.value}</span>
        ),
      )}
    </p>
    <div class="statement__shade" aria-hidden="true" data-statement-shade></div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { riseOver } from '../../scripts/rise-over';

  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector<HTMLElement>('[data-statement]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && !reducedMotion) {
    const panel = section.querySelector<HTMLElement>('[data-statement-panel]');
    const words = section.querySelectorAll<HTMLElement>('[data-statement-word]');

    // 1. Entrance: the panel scrolls up over the hero, which recedes behind it
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    riseOver({
      trigger: section,
      panel: panel ?? section,
      recede: {
        content: hero?.querySelector('[data-hero-content]'),
        shade: hero?.querySelector('[data-hero-shade]'),
      },
    });

    // 2. Reading: the sentence shows as a ghost, then each word fills in with
    //    the scroll. Scrubbed with a short lag so it feels smooth, not mechanical.
    gsap
      .timeline({
        // Reading distance comes from CSS (it changes per breakpoint); the rest
        // of the section is the hold and the next section's entrance
        scrollTrigger: {
          trigger: section,
          start: 'top 35%',
          end: () => {
            const read = parseFloat(getComputedStyle(section).getPropertyValue('--statement-read'));
            return `+=${(read / 100) * window.innerHeight}`;
          },
          scrub: 0.6,
        },
      })
      .fromTo(words, { opacity: 0.14 }, { opacity: 1, duration: 1, stagger: 0.35, ease: 'power1.inOut' });
  }
</script>
