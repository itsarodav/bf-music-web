---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Variant = 'primary' | 'secondary' | 'tertiary';
type Size = 'sm' | 'md' | 'lg';
type Breakpoint = 'mobile' | 'tablet' | 'desktop' | 'wide';

// Mobile first: `base` applies from 0px, each breakpoint overrides upwards.
// e.g. size={{ base: 'md', desktop: 'sm' }}
type ResponsiveSize = Size | ({ base: Size } & Partial<Record<Breakpoint, Size>>);

interface IconConfig {
  name: string;
  color?: string;
}

interface Props {
  variant?: Variant;
  size?: ResponsiveSize;
  href?: string;
  external?: boolean;
  icon?: string | IconConfig;
  iconPosition?: 'start' | 'end';
  /** Background the button sits on: variants are tuned for photos/dark by default */
  surface?: 'dark' | 'light';
  /** Required when the button has no visible text (icon-only) */
  ariaLabel?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  class?: string;
  attrs?: HTMLAttributes<'a'> & HTMLAttributes<'button'>;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  icon,
  iconPosition = 'start',
  surface = 'dark',
  ariaLabel,
  type = 'button',
  disabled = false,
  fullWidth = false,
  class: className,
  attrs = {},
} = Astro.props;

const iconConfig: IconConfig | undefined = typeof icon === 'string' ? { name: icon } : icon;
const hasLabel = Astro.slots.has('default');

const sizeClasses =
  typeof size === 'string'
    ? [`btn--${size}`]
    : Object.entries(size).map(([bp, value]) => (bp === 'base' ? `btn--${value}` : `btn--${bp}-${value}`));

const classes = [
  'btn',
  `btn--${variant}`,
  ...sizeClasses,
  !hasLabel && 'btn--icon-only',
  iconPosition === 'end' && 'btn--icon-end',
  surface === 'light' && 'btn--on-light',
  fullWidth && 'btn--full',
  className,
].filter(Boolean);

const Tag = href ? 'a' : 'button';

const linkProps = href
  ? {
      href: disabled ? undefined : href,
      'aria-disabled': disabled ? 'true' : undefined,
      tabindex: disabled ? -1 : undefined,
      ...(external && { target: '_blank', rel: 'noopener noreferrer' }),
    }
  : { type, disabled };
---

<Tag class:list={classes} aria-label={ariaLabel} {...linkProps} {...attrs}>
  {iconConfig && <Icon name={iconConfig.name} color={iconConfig.color} class="btn__icon" />}
  {hasLabel && <span class="btn__label"><slot /></span>}
</Tag>

<style lang="scss">
  @use 'sass:map';
  @use '../../styles/tokens' as *;
  @use '../../styles/base/breakpoints' as *;
  @use '../../styles/base/mixins' as *;

  // Size scale. Each size only sets custom properties, so responsive
  // modifiers (.btn--desktop-sm) can swap them without duplicating rules.
  $sizes: (
    'sm': (height: 2.25rem, padding-x: 0.875rem, gap: 0.375rem, font-size: $text-sm, icon: 1.125rem),
    'md': (height: 2.5rem, padding-x: 1rem, gap: 0.5rem, font-size: $text-base, icon: 1.25rem),
    'lg': (height: 3rem, padding-x: 1.5rem, gap: 0.625rem, font-size: $text-lg, icon: 1.5rem),
  );

  @mixin size-vars($size) {
    $s: map.get($sizes, $size);
    --btn-height: #{map.get($s, height)};
    --btn-padding-x: #{map.get($s, padding-x)};
    --btn-gap: #{map.get($s, gap)};
    --btn-font-size: #{map.get($s, font-size)};
    --btn-icon-size: #{map.get($s, icon)};
  }

  .btn {
    @include size-vars('md');
    @include focus-ring;
    @include transition(background-color, border-color, box-shadow, color, transform, opacity);

    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--btn-gap);
    min-height: var(--btn-height);
    padding: 0 var(--btn-padding-x);
    border: 1px solid transparent;
    border-radius: $radius-pill;
    font-family: $font-primary;
    font-size: var(--btn-font-size);
    font-weight: $font-semibold;
    line-height: $leading-none;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;

    &:active {
      transform: scale(0.97);
    }
  }

  // The SVG is injected with set:html, so it doesn't get Astro's scope attribute
  .btn :global(.btn__icon) {
    flex-shrink: 0;
    width: var(--btn-icon-size);
    height: var(--btn-icon-size);
  }

  // ---------- Sizes ----------
  @each $name, $_ in $sizes {
    .btn--#{$name} {
      @include size-vars($name);
    }
  }

  // Responsive sizes: .btn--tablet-sm, .btn--desktop-lg...
  @each $bp, $width in $breakpoints {
    @media (min-width: $width) {
      @each $name, $_ in $sizes {
        .btn--#{$bp}-#{$name} {
          @include size-vars($name);
        }
      }
    }
  }

  // ---------- Variants ----------
  // Primary: frosted white pill
  .btn--primary {
    @include glass('light', $blur-md);
    color: $color-ink;

    @media (hover: hover) {
      &:hover {
        background-color: $glass-light-bg-hover;
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 1),
          $shadow-glass;
      }
    }
  }

  // Secondary: translucent glass with white text
  .btn--secondary {
    @include glass('dark', $blur-md);
    color: $color-text-on-dark;

    @media (hover: hover) {
      &:hover {
        background:
          linear-gradient(180deg, $glass-dark-bg-hover 0%, $glass-dark-bg-top 100%),
          $glass-tint;
        border-color: $glass-dark-border-hover;
      }
    }
  }

  // Tertiary: ghost, glass only appears on interaction
  .btn--tertiary {
    background-color: transparent;
    color: $color-text-on-dark;

    @media (hover: hover) {
      &:hover {
        @include glass('dark', $blur-sm);
      }
    }
  }

  // ---------- Light surfaces ----------
  // Same shapes, ink text and a faint ink-tinted glass so they read on white
  .btn--on-light {
    &:focus-visible {
      outline-color: $color-focus-ring-on-light;
    }

    // Solid white pill with the soft ink outline
    &.btn--secondary {
      background: $color-surface-light;
      border-color: $glass-on-light-border;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.8);
      color: $color-ink;

      @media (hover: hover) {
        &:hover {
          background: $glass-on-light-bg-hover;
          border-color: $color-border-light;
        }
      }
    }

    &.btn--tertiary {
      color: $color-ink;

      @media (hover: hover) {
        &:hover {
          background: $glass-on-light-bg;
          border-color: $glass-on-light-border;
          box-shadow: none;
        }
      }
    }
  }

  // ---------- Modifiers ----------
  .btn--icon-only {
    width: var(--btn-height);
    padding: 0;
  }

  .btn--icon-end {
    flex-direction: row-reverse;
  }

  .btn--full {
    width: 100%;
  }

  // ---------- States ----------
  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
    transform: none;
  }
</style>
