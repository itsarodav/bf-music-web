---
interface Props {
  name: string;
  size?: number;
  color?: string;
  /** Official brand color (.icon--brand-<name>, base/_global) instead of the text color */
  brand?: boolean;
  class?: string;
}

const { name, size = 24, color = 'currentColor', brand = false, class: className } = Astro.props;
const classes = [brand && `icon--brand-${name}`, className].filter(Boolean).join(' ');

const icons = import.meta.glob<string>('/src/icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svgPath = `/src/icons/${name}.svg`;
const svgContent = icons[svgPath] || '';

if (!svgContent) {
  console.warn(`[Icon] "${name}" not found in src/icons/`);
}

// Strip the original width/height, then inject size, color and a11y attributes.
// Only "currentColor" fills are recolored, so fixed brand details (e.g. the
// white YouTube triangle) are preserved.
const processedSvg = svgContent
  .replace(/<svg([^>]*?)\s(width|height)="[^"]*"/g, '<svg$1')
  .replace(/<svg([^>]*?)\s(width|height)="[^"]*"/g, '<svg$1')
  .replace(/<svg/, `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${classes ? ` class="${classes}"` : ''}`)
  .replace(/fill="currentColor"/g, `fill="${color}"`)
  .replace(/stroke="currentColor"/g, `stroke="${color}"`);
---

<Fragment set:html={processedSvg} />
