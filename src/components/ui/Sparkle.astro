---
// Sparkle sticker: four-point star in sunflower yellow, taller than wide, with
// slim concave arms that taper to fine points; white die-cut border and
// shadow from Sticker.
import Sticker from './Sticker.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Sticker class={className}>
  <path
    class="sparkle"
    d="M24 2C24.9 14.6 27.6 21.4 40 24C27.6 26.6 24.9 33.4 24 46C23.1 33.4 20.4 26.6 8 24C20.4 21.4 23.1 14.6 24 2Z"
  />
</Sticker>

<style lang="scss">
  @use '../../styles/tokens' as *;

  // Component tokens: one glint (grow and tilt, shrink back, settle), then a
  // rest, repeated while hovered
  $twinkle-cycle: 1.2s;
  $twinkle-scale-peak: 1.3;
  $twinkle-scale-dip: 0.85;
  $twinkle-scale-settle: 1.08;
  $twinkle-tilt-peak: 20deg;
  $twinkle-tilt-dip: -8deg;

  .sparkle {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.sticker:hover) .sparkle {
      animation: sparkle-twinkle $twinkle-cycle $ease-in-out infinite;
    }
  }

  @keyframes sparkle-twinkle {
    0%,
    60%,
    100% {
      transform: none;
    }

    20% {
      transform: scale($twinkle-scale-peak) rotate($twinkle-tilt-peak);
    }

    38% {
      transform: scale($twinkle-scale-dip) rotate($twinkle-tilt-dip);
    }

    50% {
      transform: scale($twinkle-scale-settle);
    }
  }

  // var(--sticker-fill): Sticker paints the border copy white with it
  .sparkle {
    fill: var(--sticker-fill, #{$color-sparkle});
  }
</style>
