---
import { Font } from 'astro:assets';
import '../styles/main.scss';
import Navbar from '../components/navigation/Navbar.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/footer/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Plays the CSS intro of the home hero (navbar, photo, name, card) */
  heroIntro?: boolean;
}

const { title, description = site.description, heroIntro = false } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Pianista y compositora`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(site.ogImage, Astro.site);
---

<!doctype html>
<html lang="es" class:list={{ 'has-intro': heroIntro }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts (self-hosted, see astro.config.mjs). Preload only what every page
         paints first: the display face (hero name, page titles) and upright Geist. -->
    <Font cssVariable="--font-diphylleia" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-geist" preload={[{ style: 'normal', subset: 'latin' }]} />
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Navbar />
    <div class="page-wrapper" data-page>
      <main id="main">
        <slot />
      </main>
      <Contact />
      <Footer />
    </div>
  </body>
</html>
