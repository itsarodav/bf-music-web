---
import '../styles/main.scss';
import Navbar from '../components/navigation/Navbar.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/footer/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Hide hero elements until the GSAP intro takes over (avoids a flash) */
  heroIntro?: boolean;
}

const { title, description = site.description, heroIntro = false } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Pianista y compositora`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(site.ogImage, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Diphylleia&family=Geist:ital,wght@0,100..900;1,700&display=swap"
      rel="stylesheet"
    />

    {heroIntro && (
      <script is:inline>
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('has-intro');
          // Safety net: never keep content hidden if the intro script fails
          setTimeout(() => document.documentElement.classList.remove('has-intro'), 3000);
        }
      </script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Saltar al contenido</a>
    <Navbar />
    <div class="page-wrapper" data-page>
      <main id="main">
        <slot />
      </main>
      <Contact />
      <Footer />
    </div>
  </body>
</html>
