---
import { Font } from 'astro:assets';
import '../styles/main.scss';
import Navbar from '../components/navigation/Navbar.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/footer/Footer.astro';
import { site } from '../data/site';
import { defaultLocale, getAlternates, getI18n } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  /** Plays the CSS intro of the home hero (navbar, photo, name, card) */
  heroIntro?: boolean;
}

const { locale, routeId, t, meta } = getI18n(Astro.url);
const { title, description = t('site.description'), heroIntro = false } = Astro.props;

const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | ${t('site.tagline')}`;
// The same page in every language: canonical, hreflang and og:locale
const alternates = getAlternates(routeId).map((alternate) => ({ ...alternate, url: new URL(alternate.href, Astro.site) }));
const canonicalUrl = alternates.find((alternate) => alternate.locale === locale)!.url;
const defaultUrl = alternates.find((alternate) => alternate.locale === defaultLocale)!.url;
const ogImageUrl = new URL(site.ogImage, Astro.site);
---

<!doctype html>
<html lang={meta.htmlLang} class:list={{ 'has-intro': heroIntro }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.htmlLang} href={alternate.url} />)}
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {alternates
      .filter((alternate) => alternate.locale !== locale)
      .map((alternate) => <meta property="og:locale:alternate" content={alternate.ogLocale} />)}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t('site.ogImageAlt')} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts (self-hosted, see astro.config.mjs). Preload only what every page
         paints first: the display face (hero name, page titles) and upright Geist. -->
    <Font cssVariable="--font-diphylleia" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-geist" preload={[{ style: 'normal', subset: 'latin' }]} />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skipToContent')}</a>
    <Navbar />
    <div class="page-wrapper" data-page>
      <main id="main">
        <slot />
      </main>
      <Contact />
      <Footer />
    </div>
  </body>
</html>
