---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import Statement from '../components/sections/Statement.astro';
import LatestShorts from '../components/sections/LatestShorts.astro';

import heroBg from '../assets/images/hero-bg.jpg';
import heroBgPortrait from '../assets/images/hero-bg-portrait.jpg';
import { featuredRelease } from '../data/releases';
import { getI18n, toEmParts } from '../i18n';

const { t } = getI18n(Astro.url);
---

<Layout heroIntro>
  <Hero
    titleWords={['Blanca', 'Ferrer']}
    background={heroBg}
    backgroundPortrait={heroBgPortrait}
    backgroundAlt={t('home.heroAlt')}
    card={{
      cover: featuredRelease.cover,
      coverAlt: t(`release.covers.${featuredRelease.id}`),
      text: t('home.card'),
      actions: [
        { label: 'Spotify', href: featuredRelease.links.spotify, icon: 'spotify', brandIcon: true },
        { label: 'YouTube', href: featuredRelease.links.youtube, icon: 'youtube', brandIcon: true },
      ],
    }}
  />

  <Statement label={t('home.statement.label')} parts={toEmParts(t('home.statement.text'))} />

  <LatestShorts />
</Layout>
