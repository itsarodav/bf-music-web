---
import Layout from '../layouts/Layout.astro';
import LegalContent from '../components/sections/LegalContent.astro';
import { legal } from '../data/site';
import { getI18n } from '../i18n';

const { t } = getI18n(Astro.url);

// Section order; each body is HTML with {owner}, {manager}, {email}, {domain}
const sections = ['owner', 'purpose', 'ip', 'links', 'liability', 'changes', 'law'] as const;
---

<Layout title={t('legal.terms.title')} description={t('legal.terms.description')}>
  <LegalContent title={t('legal.terms.title')} lastUpdated={legal.lastUpdated}>
    {sections.map((section) => (
      <>
        <h2>{t(`legal.terms.sections.${section}.title`)}</h2>
        <Fragment set:html={t(`legal.terms.sections.${section}.body`, legal)} />
      </>
    ))}
  </LegalContent>
</Layout>
